{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chatmi",
  "version": "0.1.0",
  "identifier": "sh.discus.chatmi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "chatmi",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/chatmi-sidecar"],
    "icon": ["icons/icon.png"]
  }
}
